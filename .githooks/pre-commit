#!/bin/sh
# No count is stated here either, for the reason it used to state one: a number in
# prose goes stale silently. The gate that policed it (check_rule_count.py) is gone
# with the rule list it was counting.
#
# The checks below, all seconds: documentation links resolve, documentation citations still point
# inside the files they name, tracked text is byte-preserved UTF-8, the
# profile tables match the profile module and the generated launchers, the FP8 band ladders still
# describe the artifacts, the calibration corpus is
# still the one the artifact's creator used, the set of production functions defaulting a CUDA stream
# has not widened, no first-party type is
# declared and never named again, no name a tool still treats as current has outlived the tree,
# no copy-paste has been
# added past the recorded baseline, no divergence from upstream inside an upstream-owned
# file has gone unrecorded, no subprocess is spawned without an explicit text encoding,
# every shipped lane figure still describes the engine and artifact it was measured on,
# and the converter tests
# pass. Each has caught a real drift in this repository --
# a README quoting a digest the pins had moved past, 181 lines of documentation re-encoded by a
# scripted edit while every other gate still passed, a suite size that had drifted from the baseline,
# a recipe defect, a block scale that one of its three carriers had moved without the others, a KV
# block-table publish left unordered against the compute stream, a declared type nothing could reach --
# and before this hook existed,
# nothing ran them automatically.
#
# Deliberately not here: the C++ suite (minutes, and it needs the GPU), the baseline gate (it runs
# ctest), compute-sanitizer (much slower again), and the Op perturbation gate. Those belong at a
# push or in CI, which is why tools/scripts/test_v3.cmd and tools/scripts/test_v3_compute_sanitizer.cmd
# exist.
#
# The perturbation gate was in this hook once and was removed deliberately, because it reads a build
# artifact rather than source. Every check here reads tracked files, so it is current by
# construction; that one ran ctest against whatever binary happened to be in build-test, and with the
# kernel edited but not rebuilt it reported PASS -- a false green, which is worse than no check,
# since it turns an untested commit into an apparently tested one. It now builds what it perturbs
# and runs at the tail of test_v3.cmd, where "freshly built" is a precondition rather than a hope.
# What survives here is the manifest half: 19 tests that validate the declarations with no build and
# no GPU, which is the drift most likely to happen and the hardest to notice.
#
# Enable with: git config core.hooksPath .githooks
# Skip once with: git commit --no-verify
set -e
PY="${NINFER_PYTHON:-C:/vllm-env/Scripts/python.exe}"
root="$(git rev-parse --show-toplevel)"
cd "$root"

# The interpreter may be a command on PATH or a path to a file, and the two need different tests:
# `-x` asks whether a *file* is executable, so it rejects "python" and accepted only the local
# path -- which is why every CI run failed on this line while every local commit passed.
if command -v "$PY" >/dev/null 2>&1; then
    :
elif [ -x "$PY" ]; then
    :
else
    echo "pre-commit: python not found at $PY (set NINFER_PYTHON to override)" >&2
    exit 1
fi
echo "pre-commit: interpreter $PY"

# On Windows two things a test needs are not on PATH in a plain shell, and both fail as an
# environment error that reads like a test failure:
#   * ninja, which lives in the interpreter's own Scripts directory and which torch's
#     cpp_extension shells out to when a test builds a C++/CUDA extension at run time
#     (tests/convert/quantization/test_stored_scale.py does exactly that);
#   * the CUDA runtime DLLs, from CUDA_PATH, which the built .pyd loads at import.
# Found the hard way: all three of that file's extension tests failed here with "Ninja is required"
# and "DLL load failed while importing ninfer_stored_scale", and passed with these two on PATH.
if [ -n "${WINDIR:-}" ]; then
    # cygpath, because a Windows-form path pasted into PATH is not a path this shell can resolve:
    # `command -v ninja` answered nothing while `PATH` looked right, and the test then failed with
    # "Ninja is required" for an environment reason. Doing it the other way round is how that cost
    # an hour.
    if command -v cygpath >/dev/null 2>&1; then
        PATH="$(cygpath -u "$(dirname "$PY")"):$PATH"
        if [ -n "${CUDA_PATH:-}" ]; then
            PATH="$(cygpath -u "$CUDA_PATH")/bin:$PATH"
        fi
        export PATH
    else
        echo "pre-commit: WARNING cygpath not found; a test that builds an extension may not find ninja" >&2
    fi
fi

# A gate is run through this so a failure shows its reason. The two gates that print a report are
# quiet when they agree, which is what keeps a commit clean, but their output used to be discarded
# outright -- so a gate that *crashed* rather than disagreed produced one silent line and no
# explanation, and five CI runs failed that way with nothing to read.
gate() {
    label="$1"
    shift
    echo "pre-commit: $label"
    output="$("$@" 2>&1)" || {
        status=$?
        echo "pre-commit: $label failed" >&2
        printf '%s\n' "$output" | tail -40 >&2
        exit "$status"
    }
}

gate "documentation links" "$PY" tools/release/check_doc_links.py
gate "documentation citations" "$PY" tools/release/check_doc_citations.py
gate "text encoding" "$PY" tools/release/check_text_encoding.py
gate "FP8 band ladders" "$PY" tools/release/check_fp8_band_ladders.py
gate "profile consistency" "$PY" tools/release/check_profile_consistency.py
gate "calibration corpus" "$PY" tools/release/check_calibration_corpus.py
gate "stream-default ratchet" "$PY" tools/release/check_production_stream_defaults.py
gate "dead types" "$PY" tools/release/check_dead_types.py
gate "retired names" "$PY" tools/release/check_retired_names.py
gate "activity predicate" "$PY" tools/release/check_activity_predicate.py
gate "new duplication" "$PY" tools/release/check_duplication.py
# The upstream remote is a local-only ref: actions/checkout clones origin alone, so CI has no
# upstream/dev and the gate would fail there on a machine that cannot fetch it. Skip loudly,
# rather than failing every CI commit.
# The ref must be the one check_port_delta.py compares against, or the skip condition guards a
# different ref than the gate reads.
if git rev-parse --verify --quiet upstream/dev >/dev/null; then
    gate "port delta" "$PY" tools/release/check_port_delta.py --check
    gate "subprocess encoding" "$PY" tools/release/check_subprocess_encoding.py
else
    echo "pre-commit: SKIPPED port delta -- upstream/dev is not a local ref (run: git fetch upstream)"
fi
echo "pre-commit: converter tests"
# The doc-link test is named explicitly: tests/release also holds a ctest script that exits at import,
# so collecting the directory would abort the run instead of adding to it. The calibration-corpus and
# perturbation tests are named for the same reason, and because a gate whose failure paths have never
# been run is indistinguishable from one that always passes.
#
# Through tools/scripts/precommit_pytest.cmd on Windows, which supplies the MSVC environment: one of
# these tests builds a torch extension at run time and torch finds the compiler with `where cl`,
# which is not on PATH in a plain shell. The argument list stays here so there is one definition of
# what this step runs.
PYTEST_ARGS="tests/convert tests/artifact tests/release/test_doc_links.py tests/release/test_text_encoding.py tests/release/test_calibration_corpus.py tests/release/test_test_mutation.py tests/release/test_subprocess_encoding.py tests/release/test_test_baseline_cache.py tests/release/test_lane_figures.py tests/release/test_retired_names.py tests/release/test_activity_predicate.py tests/release/test_reference_audit.py tests/release/test_profile_consistency.py tests/release/test_media_acquire_windows_link.py tests/bench/test_request_log_reader.py tests/bench/test_session_tools.py"
if [ -n "${WINDIR:-}" ] && [ -f tools/scripts/precommit_pytest.cmd ]; then
    NINFER_PYTHON="$PY" cmd //c "tools\\scripts\\precommit_pytest.cmd $PYTEST_ARGS -q"
else
    "$PY" -m pytest $PYTEST_ARGS -q
fi
echo "pre-commit: ruff"
"$PY" -m ruff check tools tests --quiet
echo "pre-commit: mypy"
"$PY" -m mypy tools/release tools/convert tests
echo "pre-commit: lane figures"
# Fails when a shipped lane figure was measured under an engine or an artifact that has since changed,
# or when the profile table disagrees with the fingerprint that produced it. The remedy is to re-run
# tools/bench/lane_fingerprint.py, which needs the card; this check itself is CPU-only and fast, and
# skips with a note in a checkout that has no build.
"$PY" tools/release/check_lane_figures.py || exit 1
echo "pre-commit: ok"
